# Пример конфигурации Nginx для поддомена edu.ваш-домен.ru (SPEC §11).
# Nginx отдаёт статику клиента из dist и проксирует /api/ на Node
# (Fastify слушает 127.0.0.1:3000, см. server/.env PORT).
#
# Установка: скопировать в /etc/nginx/sites-available/edu.example.ru,
# заменить example.ru на реальный домен и пути, затем:
#   ln -s /etc/nginx/sites-available/edu.example.ru /etc/nginx/sites-enabled/
#   certbot --nginx -d edu.example.ru
#   nginx -t && systemctl reload nginx

# Файл подключается внутри http{} (стандартный sites-enabled Ubuntu).
# $uri — нормализованный путь без query. Не пишем Referer, User-Agent,
# Cookie, Authorization или body: они могут содержать секреты.
map $uri $lms_log_path {
    ~*^/invite/ /invite/MASKED;
    ~*^/api/auth/invitations/(?!check$|accept$) /api/auth/invitations/MASKED;
    default $uri;
}
log_format lms_private '$remote_addr [$time_local] "$request_method $lms_log_path" '
                       '$status $body_bytes_sent $request_time $upstream_status $upstream_response_time';

server {
    listen 80;
    listen [::]:80;
    server_name edu.example.ru;
    access_log /var/log/nginx/lms.access.log lms_private;
    error_log /var/log/nginx/lms.error.log warn; # debug logging may expose body/headers
    add_header Referrer-Policy "no-referrer" always;
    # certbot допишет сюда редирект на https после выпуска сертификата
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name edu.example.ru;
    access_log /var/log/nginx/lms.access.log lms_private;
    error_log /var/log/nginx/lms.error.log warn;
    add_header Referrer-Policy "no-referrer" always;

    # certbot --nginx допишет ssl_certificate/ssl_certificate_key сюда

    root /var/www/lms/client-dist;
    index index.html;

    client_max_body_size 55m; # лимит вложений урока — 50 МиБ (SPEC §18) + запас на заголовки

    # Приложение — PWA: index.html и файл манифеста/service worker не кэшируются
    # браузером, иначе обновление версии не долетит до пользователей.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }
    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        add_header Referrer-Policy "no-referrer" always;
        default_type application/manifest+json;
        try_files $uri =404;
    }

    # Остальная статика (хэшированные имена файлов сборки) — кэшируется надолго
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }

    # Скрытые файлы (.env, .git и т.п.) никогда не отдаются
    location ~ /\. {
        deny all;
    }

    # API — проксируется на Node с срезанием префикса /api
    # Вложения доступны только через API с проверкой доступа, не как статика.
    location ^~ /uploads/ {
        return 404;
    }

    location /api/ {
        # Standard error_log can append an unredacted legacy Referer at 502.
        # Use safe access-log status/timings and the sanitized Fastify logger.
        error_log /dev/null emerg;
        # Приватный API никогда не использует унаследованный proxy_cache.
        proxy_cache off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;
        proxy_hide_header Cache-Control;
        proxy_hide_header Referrer-Policy;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Старые API-клиенты должны обновить страницу. Nginx error_log не
    # поддерживает маскирование: эти URI не проксируем и не пишем ошибки.
    # Новые фиксированные POST /check и /accept передают token в body.
    location ~* ^/api/auth/invitations/(?!check/?$|accept/?$) {
        error_log /dev/null emerg;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        return 410;
    }

    # Старые ссылки открывают ту же оболочку; клиент удаляет token из URL.
    # Последний аргумент =404 не делает redirect в другой location, поэтому
    # даже ошибка чтения файла не попадёт в унаследованный error_log.
    location ~* ^/invite(?:/|$) {
        error_log /dev/null emerg;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /index.html =404;
    }

    # SPA fallback: любой прочий путь отдаёт
    # оболочку приложения, маршрутизация — на стороне клиента
    location / {
        try_files $uri $uri/ /index.html;
    }
}
