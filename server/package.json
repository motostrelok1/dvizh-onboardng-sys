{
  "name": "lms-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "dotenv -e .env -- node-pg-migrate -m migrations up",
    "migrate:down": "dotenv -e .env -- node-pg-migrate -m migrations down",
    "seed:admin": "dotenv -e .env -- tsx scripts/seed-admin.ts",
    "invite": "dotenv -e .env -- tsx scripts/create-invitation.ts",
    "test": "node --test --import tsx dist_test_placeholder"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.0",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/bcryptjs": "^2.4.6",
    "node-pg-migrate": "^7.6.1",
    "dotenv-cli": "^7.4.2"
  }
}
