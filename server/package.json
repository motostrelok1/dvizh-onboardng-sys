{
  "name": "lms-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "dotenv -e .env -- node-pg-migrate -m migrations up",
    "migrate:down": "dotenv -e .env -- node-pg-migrate -m migrations down",
    "check:content-integrity": "dotenv -e .env -- tsx scripts/check-content-integrity.ts",
    "check:attempt-integrity": "dotenv -e .env -- tsx scripts/check-attempt-integrity.ts",
    "seed:admin": "dotenv -e .env -- tsx scripts/seed-admin.ts",
    "invite": "dotenv -e .env -- tsx scripts/create-invitation.ts",
    "vapid:generate": "tsx scripts/generate-vapid-keys.ts",
    "test": "node --test --import tsx tests/*.test.mjs"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.2",
    "fastify": "^4.28.1",
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.0",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3",
    "web-push": "^3.6.7",
    "cfb": "1.2.2",
    "fast-xml-parser": "5.11.2",
    "file-type": "22.1.1",
    "pdf-lib": "1.17.1",
    "yauzl": "3.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/web-push": "^3.6.4",
    "node-pg-migrate": "^7.6.1",
    "dotenv-cli": "^7.4.2"
  }
}
