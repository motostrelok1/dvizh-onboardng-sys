PORT=3000
# Browser origin of the LMS. On production replace with its actual HTTPS address
# (scheme + hostname + optional port, without /api or any other path).
APP_ORIGIN=http://localhost:5173
# Set the same strong URL-encoded password as POSTGRES_PASSWORD in the root .env.
DATABASE_URL=postgres://lms:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/lms
UPLOAD_DIR=./uploads
# Resource guards for one shared upload root (same values on every backend).
UPLOAD_MAX_CONCURRENT=2
UPLOAD_MIN_FREE_BYTES=268435456
UPLOAD_TIMEOUT_MS=120000
# Сгенерировать: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
